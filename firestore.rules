rules_version = '2';

// Reglas de seguridad de Fusa Conecta v3 (Documento Técnico v2, cap. 4.8).
// Toda la seguridad vive aquí: el cliente no puede saltarse estas reglas.
// - Directorio público: solo comercios aprobados por un administrador.
// - Roles: usuario, comerciante y admin (admin solo se asigna a mano en la consola).
// - Cupones (plan Spark, sin Cloud Functions): obtener un cupón exige, en la MISMA
//   transacción, descontar 1 al cupo y crear el canje {cuponId}_{uid}.
//
// Desplegar:  firebase deploy --only firestore:rules --project fusa-conecta
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Funciones auxiliares ---------- */
    function autenticado() { return request.auth != null; }
    function cuentaReal() {
      return autenticado() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function tienePerfil() {
      return cuentaReal() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function esAdmin() { return tienePerfil() && perfil().rol == 'admin'; }
    function esComerciante() { return tienePerfil() && perfil().rol in ['comerciante', 'admin']; }
    function comercio(id) { return get(/databases/$(database)/documents/comercios/$(id)).data; }
    function duenoDe(comercioId) {
      return cuentaReal() && comercio(comercioId).get('propietario_uid', '') == request.auth.uid;
    }
    function premiumVigente(c) {
      return c.get('esPremium', false) == true
        && (c.get('suscripcion_vigente_hasta', null) == null || c.suscripcion_vigente_hasta > request.time);
    }
    function duenoPremium(comercioId) { return duenoDe(comercioId) && premiumVigente(comercio(comercioId)); }
    function cambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos); }
    function soloCambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }
    // v91: «Atiendo a domicilio» y las zonas que cubre (texto corto)
    function domicilioValido(d) {
      return d.get('a_domicilio', false) is bool
        && d.get('zona_cobertura', '') is string && d.get('zona_cobertura', '').size() <= 120;
    }
    // v93: menú para pedidos por WhatsApp, máximo 40 productos
    function menuValido(d) {
      return d.get('menu', []) is list && d.get('menu', []).size() <= 40;
    }

    /* ---------- Usuarios: identidad y consentimiento Ley 1581 ---------- */
    match /usuarios/{uid} {
      allow read: if (cuentaReal() && request.auth.uid == uid) || esAdmin();
      // Solo se crea como usuario o comerciante; "admin" se asigna a mano en la consola.
      allow create: if cuentaReal() && request.auth.uid == uid
        && request.resource.data.consentimiento_ley1581 == true
        && request.resource.data.rol in ['usuario', 'comerciante'];
      // El propio usuario no puede cambiar su rol (salvo pasar de usuario a comerciante)
      // ni la fecha de su consentimiento.
      // "confiable" (organizador que publica sin revisión) solo lo pone el admin o la invitación.
      // Pasar a "organizador": solo con una invitación del admin para su correo verificado.
      allow update: if (cuentaReal() && request.auth.uid == uid
          && request.resource.data.fecha_consentimiento == resource.data.fecha_consentimiento
          && request.resource.data.consentimiento_ley1581 == true
          && ((request.resource.data.get('confiable', false) == resource.data.get('confiable', false)
              && (request.resource.data.rol == resource.data.rol
                || (resource.data.rol == 'usuario' && request.resource.data.rol == 'comerciante')))
            || (resource.data.rol == 'usuario' && request.resource.data.rol == 'organizador'
              && request.auth.token.email_verified == true
              && exists(/databases/$(database)/documents/invitaciones/$(request.auth.token.email.lower()))
              && request.resource.data.get('confiable', false) == get(/databases/$(database)/documents/invitaciones/$(request.auth.token.email.lower())).data.get('confiable', false))))
        || esAdmin();
      allow delete: if (cuentaReal() && request.auth.uid == uid) || esAdmin();

      // Celulares donde la persona aceptó los avisos (token de FCM como id). Solo ella los crea, actualiza
      // (último uso) y borra; nadie los lee desde la app. La API de avisos los lee con su cuenta de servicio.
      match /dispositivos/{token} {
        allow read: if false;
        allow create, update: if cuentaReal() && request.auth.uid == uid
          && token.size() <= 300
          && request.resource.data.keys().hasOnly(['plataforma', 'creado', 'ultimo_uso'])
          && request.resource.data.plataforma in ['android', 'iphone', 'computador']
          && request.resource.data.ultimo_uso == request.time;
        allow delete: if cuentaReal() && request.auth.uid == uid;
      }

      // Novedades personales (aprobaciones y rechazos): las escribe solo la API de avisos.
      // La persona las lee y solo puede marcarlas como leídas.
      match /notificaciones/{id} {
        allow read: if cuentaReal() && request.auth.uid == uid;
        allow update: if cuentaReal() && request.auth.uid == uid && soloCambia(['leida'])
          && request.resource.data.leida == true;
      }
    }

    /* ---------- Comercios ---------- */
    /* ---------- Reclamos de comercios (Fase 5) ----------
       id = <comercio_id>__<uid>: un solo reclamo por comercio y persona; dos personas pueden reclamar el mismo comercio.
       La persona crea y lee los suyos y, si se lo rechazan, puede volver a enviarlo. La decisión (aprobar o rechazar) la
       toma la API con su cuenta de servicio (POST /v1/reclamos/{id}/decision): solo un admin, nunca sobre su propio
       reclamo. Ningún navegador escribe la decisión ni propietario_uid. El admin lee y borra. */
    function sinDueno(cid) {
      return !exists(/databases/$(database)/documents/comercios/$(cid))
        || get(/databases/$(database)/documents/comercios/$(cid)).data.get('propietario_uid', null) == null;
    }
    function reclamoValido(d, id) {
      return d.keys().hasOnly(['comercio_id', 'comercio_nombre', 'usuario_uid', 'nombre', 'cargo', 'telefono', 'metodo',
                               'con_prueba', 'correo', 'estado', 'consentimiento_ley1581', 'fecha_solicitud',
                               'fecha_consentimiento'])
        && d.keys().hasAll(['comercio_id', 'comercio_nombre', 'usuario_uid', 'nombre', 'cargo', 'telefono', 'metodo',
                            'con_prueba', 'estado', 'consentimiento_ley1581', 'fecha_solicitud', 'fecha_consentimiento'])
        && d.comercio_id is string && d.comercio_id.size() > 0 && d.comercio_id.size() <= 120
        && id == d.comercio_id + '__' + request.auth.uid
        && d.usuario_uid == request.auth.uid
        && d.estado == 'pendiente'
        && d.comercio_nombre is string && d.comercio_nombre.size() <= 120
        && d.nombre is string && d.nombre.size() >= 3 && d.nombre.size() <= 80
        && d.cargo in ['dueño', 'administrador']
        && d.telefono is string && d.telefono.matches('^[0-9]{7,10}$')
        && d.metodo in ['codigo', 'documento']
        && d.con_prueba == (d.metodo == 'documento')
        && d.get('correo', '') is string && d.get('correo', '').size() <= 120
        && d.consentimiento_ley1581 == true
        && d.fecha_solicitud == request.time && d.fecha_consentimiento == request.time
        && sinDueno(d.comercio_id);
    }
    match /reclamos_comercio/{id} {
      allow create: if cuentaReal() && reclamoValido(request.resource.data, id);
      allow read: if esAdmin() || (cuentaReal() && resource.data.usuario_uid == request.auth.uid);
      // Volver a reclamar después de un rechazo (el documento se reemplaza completo)
      allow update: if cuentaReal() && resource.data.usuario_uid == request.auth.uid && resource.data.estado == 'rechazado'
          && reclamoValido(request.resource.data, id);
      allow delete: if esAdmin();

      // Foto de la prueba (≈ 200 KB en WebP, como las fotos de los negocios): la envía quien reclama, la ve el admin
      match /prueba/{doc} {
        function reclamoDespues() { return getAfter(/databases/$(database)/documents/reclamos_comercio/$(id)).data; }
        allow create, update: if cuentaReal() && doc == 'foto'
          && reclamoDespues().usuario_uid == request.auth.uid && reclamoDespues().estado == 'pendiente'
          && request.resource.data.keys().hasOnly(['data', 'fecha'])
          && request.resource.data.data is string && request.resource.data.data.size() <= 280000
          && request.resource.data.data.matches('^data:image/(webp|jpeg);base64,.*')
          && request.resource.data.fecha == request.time;
        allow read: if esAdmin()
          || (cuentaReal() && get(/databases/$(database)/documents/reclamos_comercio/$(id)).data.usuario_uid == request.auth.uid);
        allow delete: if esAdmin();
      }
    }

    match /comercios/{id} {
      // Público: solo aprobados. El dueño ve los suyos en cualquier estado. El admin, todos.
      allow read: if resource.data.get('estado_publicacion', '') == 'aprobado'
        || (cuentaReal() && resource.data.get('propietario_uid', '') == request.auth.uid)
        || esAdmin();
      // Cualquier persona con cuenta registra un negocio: entra "pendiente" de revisión, sin Premium y con máx. 4 fotos.
      // El admin crea la copia en la nube de un lugar del directorio (datos.js) al corregirlo o subirle fotos.
      // Fase 5: ningún navegador pone dueño a un comercio existente ni a la copia de uno del directorio: lo hace la API
      allow create: if (esAdmin() && request.resource.data.get('propietario_uid', null) == null)
        || (tienePerfil()
        && request.resource.data.get('fotos', []).size() <= 4
        && request.resource.data.propietario_uid == request.auth.uid
        && request.resource.data.estado_publicacion == 'pendiente'
        && request.resource.data.get('esPremium', false) == false
        && request.resource.data.get('prioridadBusqueda', 0) == 0
        && !request.resource.data.keys().hasAny(['suscripcion_vigente_hasta', 'prueba_usada', 'fecha_aprobacion', 'motivo_rechazo'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && domicilioValido(request.resource.data) && menuValido(request.resource.data)
        // La portada en el documento es una miniatura: máx. ~56 000 caracteres (≈ 40 KB)
        && request.resource.data.get('imagen', '').size() <= 56000);
      // El dueño edita su ficha, pero solo el admin cambia publicación, Premium y prioridad.
      // Excepción: el dueño puede reenviar a revisión un comercio rechazado.
      allow update: if (esAdmin() && !cambia(['propietario_uid']))
        || (cuentaReal() && resource.data.get('propietario_uid', '') == request.auth.uid
            && !cambia(['propietario_uid', 'esPremium', 'suscripcion_vigente_hasta', 'prioridadBusqueda', 'prueba_usada', 'plan', 'fecha_aprobacion'])
            && request.resource.data.get('fotos', []).size() <= (premiumVigente(resource.data) ? 10 : 4)
            && domicilioValido(request.resource.data) && menuValido(request.resource.data)
            && (!cambia(['imagen']) || request.resource.data.get('imagen', '').size() <= 56000)
            && (!cambia(['estado_publicacion', 'motivo_rechazo'])
                || (resource.data.get('estado_publicacion', '') == 'rechazado'
                    && request.resource.data.estado_publicacion == 'pendiente')));
      allow delete: if esAdmin()
        || (cuentaReal() && resource.data.get('propietario_uid', '') == request.auth.uid);

      // Fotos (comercios/{id}/fotos/{foto}): una por documento, máx. ~280 000 caracteres (≈ 200 KB en WebP).
      // Se crean en el mismo lote que el negocio y solo si su id está en la lista "fotos" del negocio.
      match /fotos/{foto} {
        function negocioDespues() { return getAfter(/databases/$(database)/documents/comercios/$(id)).data; }
        allow read: if comercio(id).get('estado_publicacion', '') == 'aprobado' || duenoDe(id) || esAdmin();
        allow create: if (esAdmin() || (cuentaReal() && negocioDespues().get('propietario_uid', '') == request.auth.uid))
          && foto in negocioDespues().get('fotos', [])
          && request.resource.data.keys().hasOnly(['data', 'ancho', 'alto', 'bytes', 'fecha'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 280000;
        allow update: if false;
        allow delete: if esAdmin() || duenoDe(id);
      }

      // Estadísticas del mes (comercios/{id}/estadisticas/{aaaa-mm}): cualquier visitante con sesión
      // (incluido el invitado) solo puede sumar 1 a UN contador; las leen el dueño y el admin.
      match /estadisticas/{mes} {
        function contadores() { return ['vistas', 'toques_wa', 'toques_llamar', 'cupones_obtenidos', 'cupones_canjeados']; }
        function sube(campo) {
          return request.resource.data.get(campo, 0) == resource.data.get(campo, 0)
            || request.resource.data.get(campo, 0) == resource.data.get(campo, 0) + 1;
        }
        allow read: if esAdmin()
          || (cuentaReal() && get(/databases/$(database)/documents/comercios/$(id)).data.get('propietario_uid', '') == request.auth.uid);
        allow create: if autenticado()
          && request.resource.data.keys().hasOnly(contadores())
          && request.resource.data.keys().size() == 1
          && request.resource.data.get('vistas', 1) == 1 && request.resource.data.get('toques_wa', 1) == 1
          && request.resource.data.get('toques_llamar', 1) == 1 && request.resource.data.get('cupones_obtenidos', 1) == 1
          && request.resource.data.get('cupones_canjeados', 1) == 1;
        allow update: if autenticado()
          && request.resource.data.keys().hasOnly(contadores())
          && request.resource.data.diff(resource.data).affectedKeys().size() == 1
          && sube('vistas') && sube('toques_wa') && sube('toques_llamar')
          && sube('cupones_obtenidos') && sube('cupones_canjeados');
      }
    }

    /* ---------- Calificaciones: una por usuario y comercio (id "<comercio>_<uid>") ---------- */
    match /calificaciones/{id} {
      allow read: if true;
      allow create, update: if cuentaReal()
        && id == request.resource.data.comercio_id + '_' + request.auth.uid
        && request.resource.data.usuario_uid == request.auth.uid
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1
        && request.resource.data.estrellas <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() <= 500
        // v91: nadie califica su propio negocio (los del directorio base no tienen documento ni dueño)
        && (!exists(/databases/$(database)/documents/comercios/$(request.resource.data.comercio_id))
            || comercio(request.resource.data.comercio_id).get('propietario_uid', '') != request.auth.uid);
      allow delete: if esAdmin()
        || (cuentaReal() && resource.data.usuario_uid == request.auth.uid);
    }

    /* ---------- Cupones ---------- */
    match /cupones/{id} {
      allow read: if true;
      // Solo el dueño de un comercio con Premium vigente crea cupones.
      allow create: if duenoPremium(request.resource.data.comercio_id)
        && request.resource.data.propietario_uid == request.auth.uid
        && request.resource.data.estado == 'activo'
        && request.resource.data.cupo_total is int
        && request.resource.data.cupo_total > 0
        && request.resource.data.cupo_restante == request.resource.data.cupo_total;
      allow update: if
        // El dueño Premium edita su cupón (sin cambiar de comercio ni subir el cupo por encima del total)
        (duenoPremium(resource.data.comercio_id)
          && !cambia(['comercio_id', 'propietario_uid'])
          && request.resource.data.cupo_restante >= 0
          && request.resource.data.cupo_restante <= request.resource.data.cupo_total)
        // El dueño siempre puede pausar o finalizar su cupón
        || (duenoDe(resource.data.comercio_id) && soloCambia(['estado'])
          && request.resource.data.estado in ['activo', 'pausado', 'finalizado'])
        // Un cliente "obtiene" el cupón: baja exactamente 1 el cupo y crea su canje en la misma transacción
        || (cuentaReal()
          && soloCambia(['cupo_restante'])
          && resource.data.estado == 'activo'
          && resource.data.cupo_restante > 0
          && request.resource.data.cupo_restante == resource.data.cupo_restante - 1
          && !exists(/databases/$(database)/documents/canjes/$(id + '_' + request.auth.uid))
          && existsAfter(/databases/$(database)/documents/canjes/$(id + '_' + request.auth.uid)));
      allow delete: if esAdmin() || duenoDe(resource.data.comercio_id);
    }

    /* ---------- Canjes: un cupón por persona, id "<cuponId>_<uid>" ---------- */
    match /canjes/{id} {
      // Se permite consultar si existe el propio canje antes de crearlo (dentro de la transacción).
      allow get: if cuentaReal() && (
        (resource == null && id.matches('.+_' + request.auth.uid))
        || (resource != null && (resource.data.usuario_uid == request.auth.uid
                                 || resource.data.propietario_uid == request.auth.uid))
        || esAdmin());
      allow list: if (cuentaReal() && (resource.data.usuario_uid == request.auth.uid
                                       || resource.data.propietario_uid == request.auth.uid))
        || esAdmin();
      // Crear: el propio usuario, en estado "reservado", y solo si el cupo baja 1 en la misma transacción.
      allow create: if cuentaReal()
        && id == request.resource.data.cupon_id + '_' + request.auth.uid
        && request.resource.data.usuario_uid == request.auth.uid
        && request.resource.data.estado == 'reservado'
        && request.resource.data.comercio_id == get(/databases/$(database)/documents/cupones/$(request.resource.data.cupon_id)).data.comercio_id
        && request.resource.data.propietario_uid == get(/databases/$(database)/documents/cupones/$(request.resource.data.cupon_id)).data.propietario_uid
        && getAfter(/databases/$(database)/documents/cupones/$(request.resource.data.cupon_id)).data.cupo_restante
           == get(/databases/$(database)/documents/cupones/$(request.resource.data.cupon_id)).data.cupo_restante - 1;
      // Canjear: solo el dueño del comercio (o un admin), una sola vez: reservado -> usado.
      allow update: if ((cuentaReal() && resource.data.propietario_uid == request.auth.uid) || esAdmin())
        && resource.data.estado in ['reservado', 'activo']
        && request.resource.data.estado == 'usado'
        && request.resource.data.canjeado_por == request.auth.uid
        && soloCambia(['estado', 'fecha_canje', 'canjeado_por']);
    }

    /* ---------- Novedades de comercios Premium (antes "notificaciones") ---------- */
    match /notificaciones/{id} {
      allow read: if true;
      allow create: if duenoPremium(request.resource.data.comercio_id)
        && request.resource.data.titulo is string
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() <= 280;
      allow delete: if esAdmin() || duenoDe(resource.data.comercio_id);
    }

    /* ---------- Solicitudes (Premium y reclamos de negocio) ---------- */
    match /solicitudes/{id} {
      allow create: if cuentaReal()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in ['premium', 'reclamo']
        && request.resource.data.estado == 'pendiente';
      // El solicitante puede ver el estado de su propia solicitud; el admin las gestiona.
      allow read: if esAdmin() || (cuentaReal() && resource.data.uid == request.auth.uid);
      allow update, delete: if esAdmin();
    }

    /* ---------- Opiniones de la fase de pruebas: cualquiera crea (incluso invitado), solo el admin lee ---------- */
    function textoOpcional(d, campo, max) {
      return !(campo in d) || (d[campo] is string && d[campo].size() <= max);
    }
    match /opiniones/{id} {
      allow create: if request.resource.data.keys().hasOnly(['puntaje', 'temas', 'comentario', 'correo', 'uid', 'rol',
                                                             'pantalla_origen', 'version_app', 'dispositivo', 'fecha'])
        && request.resource.data.puntaje is int
        && request.resource.data.puntaje >= 1 && request.resource.data.puntaje <= 5
        && request.resource.data.fecha == request.time
        && (!('temas' in request.resource.data) || (request.resource.data.temas is list
              && request.resource.data.temas.size() <= 7
              && request.resource.data.temas.toSet().hasOnly(['Diseño', 'Facilidad de uso', 'Información de lugares',
                                                               'Cupones', 'Mapa', 'Velocidad', 'Otro'])))
        && textoOpcional(request.resource.data, 'comentario', 500)
        && textoOpcional(request.resource.data, 'correo', 120)
        && textoOpcional(request.resource.data, 'rol', 20)
        && textoOpcional(request.resource.data, 'pantalla_origen', 30)
        && textoOpcional(request.resource.data, 'version_app', 20)
        && textoOpcional(request.resource.data, 'dispositivo', 400)
        && (!('uid' in request.resource.data) || request.resource.data.uid == null
            || (autenticado() && request.resource.data.uid == request.auth.uid));
      allow read, update, delete: if esAdmin();
    }

    /* ---------- Reportes de reseñas o fichas ---------- */
    match /reportes/{id} {
      allow create: if cuentaReal() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if esAdmin();
    }

    /* ---------- Números de emergencia editables por el admin ---------- */
    match /emergencias/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    /* ---------- Alertas municipales (v89): solo el admin las publica, con fuente oficial https; las ve cualquiera.
       El registro del aviso al celular (envios/push) lo escribe solo la API con su cuenta de servicio. ---------- */
    function alertaValida(d) {
      return d.keys().hasOnly(['titulo', 'mensaje', 'tipo', 'municipio', 'fuente', 'fuente_url', 'vence', 'creada', 'por', 'estado'])
        && d.keys().hasAll(['titulo', 'mensaje', 'tipo', 'municipio', 'fuente', 'fuente_url', 'vence', 'estado'])
        && d.titulo is string && d.titulo.size() >= 3 && d.titulo.size() <= 80
        && d.mensaje is string && d.mensaje.size() >= 10 && d.mensaje.size() <= 400
        && d.tipo in ['agua', 'energia', 'via', 'clima', 'salud', 'seguridad', 'otro']
        && d.municipio in ['Ambos', 'Fusagasugá', 'Pasca']
        && d.fuente is string && d.fuente.size() >= 3 && d.fuente.size() <= 120
        && d.fuente_url is string && d.fuente_url.size() <= 500 && d.fuente_url.matches('^https://[^ ]+$')
        && d.vence is timestamp
        && d.estado in ['publicada', 'retirada'];
    }
    match /alertas/{id} {
      allow read: if true;
      allow create: if esAdmin() && alertaValida(request.resource.data) && request.resource.data.por == request.auth.uid
        && request.resource.data.estado == 'publicada';
      allow update: if esAdmin() && alertaValida(request.resource.data);
      allow delete: if esAdmin();
      match /envios/{envio} {
        allow read: if esAdmin();
        allow write: if false;
      }
    }

    /* ---------- Horarios de transporte (v90): solo el admin los publica, con fuente https y fecha de verificación ---------- */
    function rutaTransporteValida(d) {
      return d.keys().hasOnly(['empresa', 'origen', 'destino', 'salidas', 'precio', 'tel', 'fuente', 'fuente_url', 'verificado', 'activo', 'por', 'actualizado'])
        && d.keys().hasAll(['empresa', 'origen', 'destino', 'salidas', 'fuente', 'fuente_url', 'verificado', 'activo'])
        && d.empresa is string && d.empresa.size() >= 3 && d.empresa.size() <= 80
        && d.origen is string && d.origen.size() >= 2 && d.origen.size() <= 60
        && d.destino is string && d.destino.size() >= 2 && d.destino.size() <= 60
        && d.salidas is string && d.salidas.size() >= 3 && d.salidas.size() <= 300
        && d.get('precio', '') is string && d.get('precio', '').size() <= 40
        && d.get('tel', '') is string && d.get('tel', '').matches('^[0-9]{0,15}$')
        && d.fuente is string && d.fuente.size() >= 3 && d.fuente.size() <= 120
        && d.fuente_url is string && d.fuente_url.size() <= 500 && d.fuente_url.matches('^https://[^ ]+$')
        && d.verificado is timestamp && d.verificado <= request.time + duration.value(1, 'd')
        && d.activo is bool;
    }
    match /transporte/{id} {
      allow read: if true;
      allow create, update: if esAdmin() && rutaTransporteValida(request.resource.data);
      allow delete: if esAdmin();
    }

    /* ---------- Perdidos y encontrados (v97): cualquier persona con cuenta publica (es urgente), vence a los 30 días,
       quien publica lo marca resuelto o lo borra y el admin lo oculta. El WhatsApp lo muestra quien lo acepta. ---------- */
    function perdidoValido(d) {
      return d.keys().hasOnly(['tipo', 'situacion', 'titulo', 'descripcion', 'zona', 'municipio', 'fecha', 'whatsapp', 'foto',
          'autor_uid', 'autor_nombre', 'estado', 'creado', 'vence'])
        && d.keys().hasAll(['tipo', 'situacion', 'titulo', 'zona', 'municipio', 'fecha', 'whatsapp', 'autor_uid', 'estado', 'vence'])
        && d.tipo in ['mascota', 'objeto'] && d.situacion in ['perdido', 'encontrado']
        && d.titulo is string && d.titulo.size() >= 3 && d.titulo.size() <= 60
        && campoTexto(d, 'descripcion', 400) && campoTexto(d, 'autor_nombre', 40)
        && d.zona is string && d.zona.size() >= 2 && d.zona.size() <= 80
        && d.municipio in ['Fusagasugá', 'Pasca']
        && d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.whatsapp is string && d.whatsapp.matches('^3[0-9]{9}$')
        && (d.get('foto', '') == '' || (d.foto is string && d.foto.matches('data:image/(webp|jpeg);base64,.*') && d.foto.size() <= 280000))
        && d.estado in ['activo', 'resuelto', 'oculto', 'vencido']
        && d.vence is timestamp;
    }
    match /perdidos/{id} {
      allow read: if resource.data.estado in ['activo', 'resuelto'] || esAdmin()
        || (cuentaReal() && resource.data.autor_uid == request.auth.uid);
      allow create: if cuentaReal() && perdidoValido(request.resource.data)
        && request.resource.data.autor_uid == request.auth.uid && request.resource.data.estado == 'activo'
        && request.resource.data.creado == request.time
        && request.resource.data.vence > request.time && request.resource.data.vence <= request.time + duration.value(31, 'd');
      allow update: if (cuentaReal() && resource.data.autor_uid == request.auth.uid && soloCambia(['estado'])
            && resource.data.estado in ['activo', 'resuelto'] && request.resource.data.estado in ['activo', 'resuelto'])
        || (esAdmin() && perdidoValido(request.resource.data));
      allow delete: if esAdmin() || (cuentaReal() && resource.data.autor_uid == request.auth.uid);
    }

    /* ---------- Empleos locales (v98): los publica el dueño de un negocio aprobado; el admin los revisa antes. ---------- */
    function empleoValido(d) {
      return d.keys().hasOnly(['comercio_id', 'comercio_nombre', 'titulo', 'descripcion', 'jornada', 'salario', 'lugar', 'municipio',
          'whatsapp', 'autor_uid', 'estado', 'motivo', 'creado', 'vence'])
        && d.keys().hasAll(['comercio_id', 'comercio_nombre', 'titulo', 'descripcion', 'jornada', 'municipio', 'whatsapp', 'autor_uid', 'estado', 'vence'])
        && d.comercio_id is string && campoTexto(d, 'comercio_nombre', 80)
        && d.titulo is string && d.titulo.size() >= 3 && d.titulo.size() <= 60
        && d.descripcion is string && d.descripcion.size() >= 20 && d.descripcion.size() <= 600
        && d.jornada in ['tiempo_completo', 'medio_tiempo', 'por_dias', 'practica']
        && campoTexto(d, 'salario', 60) && campoTexto(d, 'lugar', 80) && campoTexto(d, 'motivo', 200)
        && d.municipio in ['Fusagasugá', 'Pasca']
        && d.whatsapp is string && d.whatsapp.matches('^3[0-9]{9}$')
        && d.estado in ['pendiente', 'publicado', 'rechazado', 'cerrado', 'vencido']
        && d.vence is timestamp;
    }
    match /empleos/{id} {
      allow read: if resource.data.estado == 'publicado' || esAdmin()
        || (cuentaReal() && resource.data.autor_uid == request.auth.uid);
      allow create: if cuentaReal() && empleoValido(request.resource.data)
        && request.resource.data.autor_uid == request.auth.uid && request.resource.data.estado == 'pendiente'
        && duenoDe(request.resource.data.comercio_id)
        && comercio(request.resource.data.comercio_id).get('estado_publicacion', '') == 'aprobado'
        && request.resource.data.creado == request.time
        && request.resource.data.vence > request.time && request.resource.data.vence <= request.time + duration.value(31, 'd');
      // El negocio solo puede cerrar su oferta; publicar o rechazar es del admin
      allow update: if (cuentaReal() && resource.data.autor_uid == request.auth.uid && soloCambia(['estado'])
            && resource.data.estado in ['pendiente', 'publicado'] && request.resource.data.estado == 'cerrado')
        || (esAdmin() && empleoValido(request.resource.data));
      allow delete: if esAdmin() || (cuentaReal() && resource.data.autor_uid == request.auth.uid);
    }

    /* ---------- Configuración pública del directorio (negocios de muestra ocultos por el admin) ---------- */
    match /config/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    /* ---------- Banners del inicio: los ve cualquiera, solo el admin los publica ----------
       banners/destacado = el espacio del negocio destacado; los demás son banners con foto (WebP/JPEG comprimido) */
    match /banners/{id} {
      allow read: if true;
      allow delete: if esAdmin();
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['tipo', 'etiqueta', 'titulo', 'texto', 'boton', 'imagen', 'enlace_tipo', 'enlace_valor', 'desde', 'hasta', 'orden', 'activo', 'comercio_id', 'fecha'])
        && ((id == 'destacado' && request.resource.data.tipo == 'destacado' && request.resource.data.comercio_id is string)
          || (id != 'destacado' && request.resource.data.tipo == 'foto'
            && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 60
            && request.resource.data.get('texto', '').size() <= 120
            && request.resource.data.imagen is string && request.resource.data.imagen.matches('data:image/(webp|jpeg);base64,.*')
            && request.resource.data.imagen.size() <= 360000
            && request.resource.data.get('etiqueta', '').size() <= 24
            && request.resource.data.get('boton', '').size() <= 20
            && request.resource.data.get('desde', '').matches('([0-9]{4}-[0-9]{2}-[0-9]{2})?')
            && request.resource.data.get('hasta', '').matches('([0-9]{4}-[0-9]{2}-[0-9]{2})?')
            && request.resource.data.get('enlace_tipo', 'ninguno') in ['ninguno', 'negocio', 'categoria', 'cupones', 'registrar']));
    }

    /* ---------- Eventos "Qué hacer en Fusa" ----------
       Público: solo publicados. Quien lo sugirió ve el suyo; el admin, todos.
       Cualquier cuenta real (no invitado) crea con estado "pendiente"; publicar, editar, descartar o borrar: solo el admin. */
    function campoTexto(d, k, max) { return d.get(k, '') is string && d.get(k, '').size() <= max; }
    function eventoValido(d) {
      return d.keys().hasOnly(['titulo', 'descripcion', 'categoria', 'fecha_inicio', 'fecha_fin', 'lugar_nombre', 'lat', 'lng', 'municipio',
          'imagen', 'organizador', 'enlace_fuente', 'gratis', 'precio', 'estado', 'origen', 'creado_por', 'fecha_creacion', 'motivo', 'demo',
          'fuente_oficial', 'tipo', 'programa', 'sin_hora_fin', 'fuentes', 'hora_por_confirmar', 'lugar_por_confirmar',
          'foto_credito', 'foto_fuente', 'con_foto', 'foto_encuadre'])
        && d.titulo is string && d.titulo.size() >= 3 && d.titulo.size() <= 80
        && campoTexto(d, 'descripcion', 1000) && campoTexto(d, 'organizador', 80) && campoTexto(d, 'precio', 60) && campoTexto(d, 'motivo', 200)
        && d.categoria in ['cultura', 'musica', 'deporte', 'gastronomia', 'feria', 'religioso', 'institucional', 'otro']
        && d.fecha_inicio is timestamp && d.fecha_fin is timestamp && d.fecha_fin >= d.fecha_inicio
        && d.lugar_nombre is string && d.lugar_nombre.size() >= 2 && d.lugar_nombre.size() <= 80
        && d.get('municipio', 'Fusagasugá') in ['Fusagasugá', 'Pasca']
        && (d.get('lat', null) == null || d.lat is number) && (d.get('lng', null) == null || d.lng is number)
        && d.get('gratis', true) is bool
        && d.get('demo', false) is bool
        && d.get('fuente_oficial', false) is bool
        // Campos de la agenda automática: programa de un festival, evento sin hora de fin y fuentes adicionales
        && campoTexto(d, 'programa', 80)
        && d.get('sin_hora_fin', false) is bool
        && d.get('hora_por_confirmar', false) is bool && d.get('lugar_por_confirmar', false) is bool
        && d.get('fuentes', []) is list && d.get('fuentes', []).size() <= 5
        // v8: plan para la gente o aviso del municipio (jornadas de salud, vacunación, cortes de servicio)
        && d.get('tipo', 'plan') in ['plan', 'aviso']
        // Fase 6: de quién es la foto y de dónde salió
        && campoTexto(d, 'foto_credito', 120)
        && d.get('foto_fuente', '') in ['', 'propia', 'oficial', 'generica']
        // La foto va en eventos/{id}/fotos/0 (con_foto: true). «imagen» es de los eventos anteriores: la agenda
        // automática la mueve a la subcolección; una foto dentro de cada evento hacía bajar 1,7 MB al abrir la app
        && d.get('con_foto', false) is bool
        // v103: cómo se ve la foto en la app: el afiche completo o un punto al centro («50% 20%»); vacío = automático
        && d.get('foto_encuadre', '') is string && d.get('foto_encuadre', '').matches('^(completa|[0-9]{1,3}% [0-9]{1,3}%)?$')
        && (d.get('imagen', '') == '' || (d.imagen is string && d.imagen.matches('data:image/(webp|jpeg);base64,.*') && d.imagen.size() <= 360000))
        && (d.get('enlace_fuente', '') == '' || (d.enlace_fuente is string && d.enlace_fuente.matches('https://[^ ]+') && d.enlace_fuente.size() <= 500))
        && d.estado in ['pendiente', 'publicado', 'rechazado']
        && d.origen in ['admin', 'organizador', 'usuario', 'ia', 'automatico']
        && d.creado_por is string;
    }
    match /eventos/{id} {
      allow read: if resource.data.estado == 'publicado' || esAdmin()
        || (cuentaReal() && resource.data.creado_por == request.auth.uid);
      allow create: if eventoValido(request.resource.data)
        // Los eventos nuevos llevan la foto aparte (fotos/0), nunca dentro del documento
        && request.resource.data.get('imagen', '') == ''
        // Solo el admin crea eventos de ejemplo (demo)
        && (esAdmin()
          || (tienePerfil() && request.resource.data.estado == 'pendiente'
            && request.resource.data.origen in ['organizador', 'usuario', 'ia']
            && request.resource.data.creado_por == request.auth.uid
            && request.resource.data.get('demo', false) == false)
          // Organizador confiable: publica directo
          || (tienePerfil() && perfil().rol == 'organizador' && perfil().get('confiable', false) == true
            && request.resource.data.estado in ['publicado', 'pendiente']
            && request.resource.data.origen in ['organizador', 'ia']
            && request.resource.data.creado_por == request.auth.uid
            && request.resource.data.get('demo', false) == false));
      // El admin publica o descarta cambiando solo el estado (y el motivo), aunque el evento traiga un campo que
      // estas reglas aún no conozcan: así un cambio en la agenda automática nunca vuelve a bloquear la revisión.
      allow update: if esAdmin() && (eventoValido(request.resource.data)
        || (soloCambia(['estado', 'motivo']) && request.resource.data.estado in ['pendiente', 'publicado', 'rechazado']
            && campoTexto(request.resource.data, 'motivo', 200)));
      allow delete: if esAdmin();

      // La foto del evento (máx. 200 KB en WebP o JPEG), aparte: la app la pide solo cuando el evento se ve en pantalla.
      // Quien sugiere un evento la sube en el mismo lote en que lo crea; después, solo el admin la cambia o la borra.
      match /fotos/{n} {
        function evento() { return get(/databases/$(database)/documents/eventos/$(id)).data; }
        function fotoValida() {
          return n == '0'
            && request.resource.data.keys().hasOnly(['data', 'ancho', 'alto', 'bytes'])
            && request.resource.data.data is string && request.resource.data.data.size() <= 280000
            && request.resource.data.data.matches('data:image/(webp|jpeg);base64,.*');
        }
        allow read: if evento().estado == 'publicado' || esAdmin()
          || (cuentaReal() && evento().creado_por == request.auth.uid);
        allow create: if fotoValida() && (esAdmin()
          || (cuentaReal() && !exists(/databases/$(database)/documents/eventos/$(id))
            && getAfter(/databases/$(database)/documents/eventos/$(id)).data.creado_por == request.auth.uid
            && getAfter(/databases/$(database)/documents/eventos/$(id)).data.get('con_foto', false) == true));
        allow update: if esAdmin() && fotoValida();
        allow delete: if esAdmin();
      }
    }

    /* ---------- Trazados oficiales (v8): el admin graba un sendero del directorio con la app y lo publica ----------
       Lectura pública. Solo el admin escribe; 150 a 300 puntos guardados como texto "lat,lng,alt;…". */
    match /rutas_oficiales/{id} {
      allow read: if true;
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['linea', 'puntos', 'distancia_km', 'desnivel_m', 'fuente', 'fecha', 'publicado_por'])
        && request.resource.data.linea is string && request.resource.data.linea.size() <= 12000
        && request.resource.data.puntos is int && request.resource.data.puntos >= 150 && request.resource.data.puntos <= 300
        && request.resource.data.distancia_km is number && request.resource.data.distancia_km > 0 && request.resource.data.distancia_km <= 60
        && request.resource.data.desnivel_m is int && request.resource.data.desnivel_m >= 0
        && request.resource.data.fuente is string && request.resource.data.fuente.size() <= 120
        && request.resource.data.fecha == request.time
        && request.resource.data.publicado_por == request.auth.uid;
      allow delete: if esAdmin();
    }

    /* ---------- Invitaciones de organizadores (las crea el admin; cada quien lee solo la de su correo) ---------- */
    match /invitaciones/{correo} {
      allow read: if esAdmin() || (cuentaReal() && request.auth.token.email != null && request.auth.token.email.lower() == correo);
    }

    /* ---------- Límite de uso de la IA: 20 al día por persona (día UTC), solo sumando de a 1 ---------- */
    /* Rutas de la comunidad (v7 · Fase 4). Una persona con cuenta propone; queda pendiente hasta que el admin la apruebe
       o la rechace con motivo. El teléfono valida la distancia y la zona con limites.geojson; aquí se validan tamaños,
       rangos, que el inicio quede en la zona de Fusagasugá y Pasca y que venga al menos una foto. */
    function rutaValida(d) {
      return d.keys().hasOnly(['autor_uid', 'autor_nombre', 'nombre', 'descripcion', 'tipo', 'dificultad', 'municipio',
          'distancia_km', 'desnivel_m', 'elev_min', 'elev_max', 'perfil', 'duracion_min', 'linea', 'inicio_lat', 'inicio_lng',
          'portada', 'n_fotos', 'origen', 'estado', 'fecha_creacion'])
        && d.autor_uid == request.auth.uid
        && d.autor_nombre is string && d.autor_nombre.size() <= 40
        && d.nombre is string && d.nombre.size() >= 5 && d.nombre.size() <= 60
        && d.descripcion is string && d.descripcion.size() >= 20 && d.descripcion.size() <= 500
        && d.tipo in ['caminata', 'bicicleta', 'trote']
        && d.dificultad in ['Baja', 'Media', 'Alta']
        && d.municipio in ['Fusagasugá', 'Pasca']
        && d.distancia_km is number && d.distancia_km >= 0.5 && d.distancia_km <= 40
        && d.desnivel_m is int && d.desnivel_m >= 0 && d.desnivel_m <= 6000
        && (d.elev_min == null || d.elev_min is int) && (d.elev_max == null || d.elev_max is int)
        && d.perfil is list && d.perfil.size() <= 60
        && d.duracion_min is int && d.duracion_min >= 1 && d.duracion_min <= 3000
        && d.linea is string && d.linea.size() >= 100 && d.linea.size() <= 20000
        && d.inicio_lat is number && d.inicio_lat >= 4.0 && d.inicio_lat <= 4.6
        && d.inicio_lng is number && d.inicio_lng >= -74.6 && d.inicio_lng <= -74.0
        && d.portada is string && d.portada.size() <= 56000 && d.portada.matches('data:image/.*')
        && d.n_fotos is int && d.n_fotos >= 1 && d.n_fotos <= 4
        && d.origen in ['grabacion', 'archivo']
        && d.estado == 'pendiente'
        && d.fecha_creacion == request.time;
    }
    match /rutas_comunidad/{id} {
      function autor() { return cuentaReal() && resource.data.autor_uid == request.auth.uid; }
      allow read: if resource.data.estado == 'aprobada' || autor() || esAdmin();
      allow create: if tienePerfil() && rutaValida(request.resource.data)
        && existsAfter(/databases/$(database)/documents/rutas_comunidad/$(id)/fotos/0);
      // Solo el admin la revisa: cambia el estado, el motivo y la fecha de revisión; rechazar exige motivo
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'motivo', 'fecha_revision'])
        && request.resource.data.estado in ['aprobada', 'rechazada']
        && request.resource.data.fecha_revision == request.time
        && (request.resource.data.estado == 'aprobada'
          || (request.resource.data.motivo is string && request.resource.data.motivo.size() >= 4 && request.resource.data.motivo.size() <= 300));
      // Quien la propuso puede retirarla mientras no esté publicada; el admin, siempre
      allow delete: if esAdmin() || (autor() && resource.data.estado != 'aprobada');

      // Fotos: una por documento (0 a 3), en el mismo lote que la ruta
      match /fotos/{n} {
        function ruta() { return get(/databases/$(database)/documents/rutas_comunidad/$(id)).data; }
        function rutaDespues() { return getAfter(/databases/$(database)/documents/rutas_comunidad/$(id)).data; }
        allow read: if ruta().estado == 'aprobada' || ruta().autor_uid == request.auth.uid || esAdmin();
        allow create: if cuentaReal()
          && rutaDespues().autor_uid == request.auth.uid && rutaDespues().estado == 'pendiente'
          && n in ['0', '1', '2', '3'] && int(n) < rutaDespues().n_fotos
          && request.resource.data.keys().hasOnly(['data', 'ancho', 'alto', 'bytes'])
          && request.resource.data.data is string && request.resource.data.data.size() <= 280000
          && request.resource.data.data.matches('data:image/.*');
        allow update: if false;
        allow delete: if esAdmin() || (cuentaReal() && ruta().autor_uid == request.auth.uid && ruta().estado != 'aprobada');
      }
    }

    /* Pregúntale a Fusa (v7 · Fase 3): preguntas por día de Colombia (UTC-5). 30 con cuenta, 10 como invitado
       (cuenta anónima del dispositivo). Solo se puede sumar de a uno; no se guarda el texto de las preguntas. */
    match /uso_asistente/{uid} {
      allow read: if autenticado() && request.auth.uid == uid;
      allow create, update: if autenticado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['dia', 'n', 'ultima'])
        && request.resource.data.dia == int((request.time.toMillis() - 18000000) / 86400000)
        && request.resource.data.n is int && request.resource.data.n >= 1
        && request.resource.data.n <= (cuentaReal() ? 30 : 10)
        && request.resource.data.ultima == request.time
        && (resource == null || resource.data.dia != request.resource.data.dia
          ? request.resource.data.n == 1
          : request.resource.data.n == resource.data.n + 1);
    }

    // v1.4.5: seguimiento de la campaña de contactos por WhatsApp (pestaña «Contactar» del panel): solo el admin
    match /contactos/{id} {
      allow read: if esAdmin();
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['estado', 'fecha', 'por', 'comercio_nombre'])
        && request.resource.data.estado in ['pendiente', 'enviado', 'respondio', 'no_interesa', 'numero_malo']
        && request.resource.data.por == request.auth.uid;
      allow delete: if esAdmin();
    }
    match /uso_ia/{uid} {
      allow read: if cuentaReal() && request.auth.uid == uid;
      allow create, update: if tienePerfil() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['dia', 'n', 'ultima'])
        && request.resource.data.dia == int(request.time.toMillis() / 86400000)
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 20
        && request.resource.data.ultima == request.time
        && (resource == null || resource.data.dia != request.resource.data.dia
          ? request.resource.data.n == 1
          : request.resource.data.n == resource.data.n + 1);
    }

    /* ---------- Moderación general (CU-18) ----------
       El admin puede todo, salvo en banners, eventos y rutas de la comunidad: ahí también debe cumplir la validación de su bloque.
       Fase 5: tampoco en comercios ni reclamos_comercio, para que ningún navegador asigne el dueño ni decida un reclamo. */
    match /{coleccion}/{documento=**} {
      allow read: if esAdmin();
      allow write: if esAdmin() && !(coleccion in ['alertas', 'banners', 'comercios', 'empleos', 'eventos', 'perdidos',
        'reclamos_comercio', 'rutas_comunidad', 'rutas_oficiales', 'transporte']);
    }
  }
}
