rules_version = '2';

// Reglas de seguridad de Fusa Conecta v3 (Documento Técnico v2, cap. 4.8).
// Toda la seguridad vive aquí: el cliente no puede saltarse estas reglas.
// - Directorio público: solo comercios aprobados por un administrador.
// - Roles: usuario, comerciante y admin (admin solo se asigna a mano en la consola).
// - Cupones (plan Spark, sin Cloud Functions): obtener un cupón exige, en la MISMA
//   transacción, descontar 1 al cupo y crear el canje {cuponId}_{uid}.
//
// Desplegar:  firebase deploy --only firestore:rules --project fusa-conecta
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Funciones auxiliares ---------- */
    function autenticado() { return request.auth != null; }
    function cuentaReal() {
      return autenticado() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function tienePerfil() {
      return cuentaReal() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function esAdmin() { return tienePerfil() && perfil().rol == 'admin'; }
    function esComerciante() { return tienePerfil() && perfil().rol in ['comerciante', 'admin']; }
    function comercio(id) { return get(/databases/$(database)/documents/comercios/$(id)).data; }
    function duenoDe(comercioId) {
      return cuentaReal() && comercio(comercioId).get('propietario_uid', '') == request.auth.uid;
    }
    function premiumVigente(c) {
      return c.get('esPremium', false) == true
        && (c.get('suscripcion_vigente_hasta', null) == null || c.suscripcion_vigente_hasta > request.time);
    }
    function duenoPremium(comercioId) { return duenoDe(comercioId) && premiumVigente(comercio(comercioId)); }
    function cambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos); }
    function soloCambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }

    /* ---------- Usuarios: identidad y consentimiento Ley 1581 ---------- */
    match /usuarios/{uid} {
      allow read: if (cuentaReal() && request.auth.uid == uid) || esAdmin();
      // Solo se crea como usuario o comerciante; "admin" se asigna a mano en la consola.
      allow create: if cuentaReal() && request.auth.uid == uid
        && request.resource.data.consentimiento_ley1581 == true
        && request.resource.data.rol in ['usuario', 'comerciante'];
      // El propio usuario no puede cambiar su rol (salvo pasar de usuario a comerciante)
      // ni la fecha de su consentimiento.
      // "confiable" (organizador que publica sin revisión) solo lo pone el admin o la invitación.
      // Pasar a "organizador": solo con una invitación del admin para su correo verificado.
      allow update: if (cuentaReal() && request.auth.uid == uid
          && request.resource.data.fecha_consentimiento == resource.data.fecha_consentimiento
          && request.resource.data.consentimiento_ley1581 == true
          && ((request.resource.data.get('confiable', false) == resource.data.get('confiable', false)
              && (request.resource.data.rol == resource.data.rol
                || (resource.data.rol == 'usuario' && request.resource.data.rol == 'comerciante')))
            || (resource.data.rol == 'usuario' && request.resource.data.rol == 'organizador'
              && request.auth.token.email_verified == true
              && exists(/databases/$(database)/documents/invitaciones/$(request.auth.token.email.lower()))
              && request.resource.data.get('confiable', false) == get(/databases/$(database)/documents/invitaciones/$(request.auth.token.email.lower())).data.get('confiable', false))))
        || esAdmin();
      allow delete: if (cuentaReal() && request.auth.uid == uid) || esAdmin();
    }

    /* ---------- Comercios ---------- */
    match /comercios/{id} {
      // Público: solo aprobados. El dueño ve los suyos en cualquier estado. El admin, todos.
      allow read: if resource.data.get('estado_publicacion', '') == 'aprobado'
        || (cuentaReal() && resource.data.get('propietario_uid', '') == request.auth.uid)
        || esAdmin();
      // Cualquier persona con cuenta registra un negocio: entra "pendiente" de revisión, sin Premium y con máx. 4 fotos.
      allow create: if tienePerfil()
        && request.resource.data.get('fotos', []).size() <= 4
        && request.resource.data.propietario_uid == request.auth.uid
        && request.resource.data.estado_publicacion == 'pendiente'
        && request.resource.data.get('esPremium', false) == false
        && request.resource.data.get('prioridadBusqueda', 0) == 0
        && !request.resource.data.keys().hasAny(['suscripcion_vigente_hasta', 'prueba_usada', 'fecha_aprobacion', 'motivo_rechazo'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        // La portada en el documento es una miniatura: máx. ~56 000 caracteres (≈ 40 KB)
        && request.resource.data.get('imagen', '').size() <= 56000;
      // El dueño edita su ficha, pero solo el admin cambia publicación, Premium y prioridad.
      // Excepción: el dueño puede reenviar a revisión un comercio rechazado.
      allow update: if esAdmin()
        || (cuentaReal() && resource.data.get('propietario_uid', '') == request.auth.uid
            && !cambia(['propietario_uid', 'esPremium', 'suscripcion_vigente_hasta', 'prioridadBusqueda', 'prueba_usada', 'plan', 'fecha_aprobacion'])
            && request.resource.data.get('fotos', []).size() <= (premiumVigente(resource.data) ? 10 : 4)
            && (!cambia(['imagen']) || request.resource.data.get('imagen', '').size() <= 56000)
            && (!cambia(['estado_publicacion', 'motivo_rechazo'])
                || (resource.data.get('estado_publicacion', '') == 'rechazado'
                    && request.resource.data.estado_publicacion == 'pendiente')));
      allow delete: if esAdmin()
        || (cuentaReal() && resource.data.get('propietario_uid', '') == request.auth.uid);

      // Fotos (comercios/{id}/fotos/{foto}): una por documento, máx. ~280 000 caracteres (≈ 200 KB en WebP).
      // Se crean en el mismo lote que el negocio y solo si su id está en la lista "fotos" del negocio.
      match /fotos/{foto} {
        function negocioDespues() { return getAfter(/databases/$(database)/documents/comercios/$(id)).data; }
        allow read: if comercio(id).get('estado_publicacion', '') == 'aprobado' || duenoDe(id) || esAdmin();
        allow create: if (esAdmin() || (cuentaReal() && negocioDespues().get('propietario_uid', '') == request.auth.uid))
          && foto in negocioDespues().get('fotos', [])
          && request.resource.data.keys().hasOnly(['data', 'ancho', 'alto', 'bytes', 'fecha'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 280000;
        allow update: if false;
        allow delete: if esAdmin() || duenoDe(id);
      }

      // Estadísticas del mes (comercios/{id}/estadisticas/{aaaa-mm}): cualquier visitante con sesión
      // (incluido el invitado) solo puede sumar 1 a UN contador; las leen el dueño y el admin.
      match /estadisticas/{mes} {
        function contadores() { return ['vistas', 'toques_wa', 'toques_llamar', 'cupones_obtenidos', 'cupones_canjeados']; }
        function sube(campo) {
          return request.resource.data.get(campo, 0) == resource.data.get(campo, 0)
            || request.resource.data.get(campo, 0) == resource.data.get(campo, 0) + 1;
        }
        allow read: if esAdmin()
          || (cuentaReal() && get(/databases/$(database)/documents/comercios/$(id)).data.get('propietario_uid', '') == request.auth.uid);
        allow create: if autenticado()
          && request.resource.data.keys().hasOnly(contadores())
          && request.resource.data.keys().size() == 1
          && request.resource.data.get('vistas', 1) == 1 && request.resource.data.get('toques_wa', 1) == 1
          && request.resource.data.get('toques_llamar', 1) == 1 && request.resource.data.get('cupones_obtenidos', 1) == 1
          && request.resource.data.get('cupones_canjeados', 1) == 1;
        allow update: if autenticado()
          && request.resource.data.keys().hasOnly(contadores())
          && request.resource.data.diff(resource.data).affectedKeys().size() == 1
          && sube('vistas') && sube('toques_wa') && sube('toques_llamar')
          && sube('cupones_obtenidos') && sube('cupones_canjeados');
      }
    }

    /* ---------- Calificaciones: una por usuario y comercio (id "<comercio>_<uid>") ---------- */
    match /calificaciones/{id} {
      allow read: if true;
      allow create, update: if cuentaReal()
        && id == request.resource.data.comercio_id + '_' + request.auth.uid
        && request.resource.data.usuario_uid == request.auth.uid
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1
        && request.resource.data.estrellas <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() <= 500;
      allow delete: if esAdmin()
        || (cuentaReal() && resource.data.usuario_uid == request.auth.uid);
    }

    /* ---------- Cupones ---------- */
    match /cupones/{id} {
      allow read: if true;
      // Solo el dueño de un comercio con Premium vigente crea cupones.
      allow create: if duenoPremium(request.resource.data.comercio_id)
        && request.resource.data.propietario_uid == request.auth.uid
        && request.resource.data.estado == 'activo'
        && request.resource.data.cupo_total is int
        && request.resource.data.cupo_total > 0
        && request.resource.data.cupo_restante == request.resource.data.cupo_total;
      allow update: if
        // El dueño Premium edita su cupón (sin cambiar de comercio ni subir el cupo por encima del total)
        (duenoPremium(resource.data.comercio_id)
          && !cambia(['comercio_id', 'propietario_uid'])
          && request.resource.data.cupo_restante >= 0
          && request.resource.data.cupo_restante <= request.resource.data.cupo_total)
        // El dueño siempre puede pausar o finalizar su cupón
        || (duenoDe(resource.data.comercio_id) && soloCambia(['estado'])
          && request.resource.data.estado in ['activo', 'pausado', 'finalizado'])
        // Un cliente "obtiene" el cupón: baja exactamente 1 el cupo y crea su canje en la misma transacción
        || (cuentaReal()
          && soloCambia(['cupo_restante'])
          && resource.data.estado == 'activo'
          && resource.data.cupo_restante > 0
          && request.resource.data.cupo_restante == resource.data.cupo_restante - 1
          && !exists(/databases/$(database)/documents/canjes/$(id + '_' + request.auth.uid))
          && existsAfter(/databases/$(database)/documents/canjes/$(id + '_' + request.auth.uid)));
      allow delete: if esAdmin() || duenoDe(resource.data.comercio_id);
    }

    /* ---------- Canjes: un cupón por persona, id "<cuponId>_<uid>" ---------- */
    match /canjes/{id} {
      // Se permite consultar si existe el propio canje antes de crearlo (dentro de la transacción).
      allow get: if cuentaReal() && (
        (resource == null && id.matches('.+_' + request.auth.uid))
        || (resource != null && (resource.data.usuario_uid == request.auth.uid
                                 || resource.data.propietario_uid == request.auth.uid))
        || esAdmin());
      allow list: if (cuentaReal() && (resource.data.usuario_uid == request.auth.uid
                                       || resource.data.propietario_uid == request.auth.uid))
        || esAdmin();
      // Crear: el propio usuario, en estado "reservado", y solo si el cupo baja 1 en la misma transacción.
      allow create: if cuentaReal()
        && id == request.resource.data.cupon_id + '_' + request.auth.uid
        && request.resource.data.usuario_uid == request.auth.uid
        && request.resource.data.estado == 'reservado'
        && request.resource.data.comercio_id == get(/databases/$(database)/documents/cupones/$(request.resource.data.cupon_id)).data.comercio_id
        && request.resource.data.propietario_uid == get(/databases/$(database)/documents/cupones/$(request.resource.data.cupon_id)).data.propietario_uid
        && getAfter(/databases/$(database)/documents/cupones/$(request.resource.data.cupon_id)).data.cupo_restante
           == get(/databases/$(database)/documents/cupones/$(request.resource.data.cupon_id)).data.cupo_restante - 1;
      // Canjear: solo el dueño del comercio (o un admin), una sola vez: reservado -> usado.
      allow update: if ((cuentaReal() && resource.data.propietario_uid == request.auth.uid) || esAdmin())
        && resource.data.estado in ['reservado', 'activo']
        && request.resource.data.estado == 'usado'
        && request.resource.data.canjeado_por == request.auth.uid
        && soloCambia(['estado', 'fecha_canje', 'canjeado_por']);
    }

    /* ---------- Novedades de comercios Premium (antes "notificaciones") ---------- */
    match /notificaciones/{id} {
      allow read: if true;
      allow create: if duenoPremium(request.resource.data.comercio_id)
        && request.resource.data.titulo is string
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() <= 280;
      allow delete: if esAdmin() || duenoDe(resource.data.comercio_id);
    }

    /* ---------- Solicitudes (Premium y reclamos de negocio) ---------- */
    match /solicitudes/{id} {
      allow create: if cuentaReal()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in ['premium', 'reclamo']
        && request.resource.data.estado == 'pendiente';
      // El solicitante puede ver el estado de su propia solicitud; el admin las gestiona.
      allow read: if esAdmin() || (cuentaReal() && resource.data.uid == request.auth.uid);
      allow update, delete: if esAdmin();
    }

    /* ---------- Opiniones de la fase de pruebas: cualquiera crea (incluso invitado), solo el admin lee ---------- */
    function textoOpcional(d, campo, max) {
      return !(campo in d) || (d[campo] is string && d[campo].size() <= max);
    }
    match /opiniones/{id} {
      allow create: if request.resource.data.keys().hasOnly(['puntaje', 'temas', 'comentario', 'correo', 'uid', 'rol',
                                                             'pantalla_origen', 'version_app', 'dispositivo', 'fecha'])
        && request.resource.data.puntaje is int
        && request.resource.data.puntaje >= 1 && request.resource.data.puntaje <= 5
        && request.resource.data.fecha == request.time
        && (!('temas' in request.resource.data) || (request.resource.data.temas is list
              && request.resource.data.temas.size() <= 7
              && request.resource.data.temas.toSet().hasOnly(['Diseño', 'Facilidad de uso', 'Información de lugares',
                                                               'Cupones', 'Mapa', 'Velocidad', 'Otro'])))
        && textoOpcional(request.resource.data, 'comentario', 500)
        && textoOpcional(request.resource.data, 'correo', 120)
        && textoOpcional(request.resource.data, 'rol', 20)
        && textoOpcional(request.resource.data, 'pantalla_origen', 30)
        && textoOpcional(request.resource.data, 'version_app', 20)
        && textoOpcional(request.resource.data, 'dispositivo', 400)
        && (!('uid' in request.resource.data) || request.resource.data.uid == null
            || (autenticado() && request.resource.data.uid == request.auth.uid));
      allow read, update, delete: if esAdmin();
    }

    /* ---------- Reportes de reseñas o fichas ---------- */
    match /reportes/{id} {
      allow create: if cuentaReal() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if esAdmin();
    }

    /* ---------- Números de emergencia editables por el admin ---------- */
    match /emergencias/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    /* ---------- Configuración pública del directorio (negocios de muestra ocultos por el admin) ---------- */
    match /config/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    /* ---------- Banners del inicio: los ve cualquiera, solo el admin los publica ----------
       banners/destacado = el espacio del negocio destacado; los demás son banners con foto (WebP/JPEG comprimido) */
    match /banners/{id} {
      allow read: if true;
      allow delete: if esAdmin();
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['tipo', 'etiqueta', 'titulo', 'texto', 'boton', 'imagen', 'enlace_tipo', 'enlace_valor', 'desde', 'hasta', 'orden', 'activo', 'comercio_id', 'fecha'])
        && ((id == 'destacado' && request.resource.data.tipo == 'destacado' && request.resource.data.comercio_id is string)
          || (id != 'destacado' && request.resource.data.tipo == 'foto'
            && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 60
            && request.resource.data.get('texto', '').size() <= 120
            && request.resource.data.imagen is string && request.resource.data.imagen.matches('data:image/(webp|jpeg);base64,.*')
            && request.resource.data.imagen.size() <= 360000
            && request.resource.data.get('etiqueta', '').size() <= 24
            && request.resource.data.get('boton', '').size() <= 20
            && request.resource.data.get('desde', '').matches('([0-9]{4}-[0-9]{2}-[0-9]{2})?')
            && request.resource.data.get('hasta', '').matches('([0-9]{4}-[0-9]{2}-[0-9]{2})?')
            && request.resource.data.get('enlace_tipo', 'ninguno') in ['ninguno', 'negocio', 'categoria', 'cupones', 'registrar']));
    }

    /* ---------- Eventos "Qué hacer en Fusa" ----------
       Público: solo publicados. Quien lo sugirió ve el suyo; el admin, todos.
       Cualquier cuenta real (no invitado) crea con estado "pendiente"; publicar, editar, descartar o borrar: solo el admin. */
    function campoTexto(d, k, max) { return d.get(k, '') is string && d.get(k, '').size() <= max; }
    function eventoValido(d) {
      return d.keys().hasOnly(['titulo', 'descripcion', 'categoria', 'fecha_inicio', 'fecha_fin', 'lugar_nombre', 'lat', 'lng', 'municipio',
          'imagen', 'organizador', 'enlace_fuente', 'gratis', 'precio', 'estado', 'origen', 'creado_por', 'fecha_creacion', 'motivo', 'demo',
          'fuente_oficial'])
        && d.titulo is string && d.titulo.size() >= 3 && d.titulo.size() <= 80
        && campoTexto(d, 'descripcion', 1000) && campoTexto(d, 'organizador', 80) && campoTexto(d, 'precio', 40) && campoTexto(d, 'motivo', 200)
        && d.categoria in ['cultura', 'musica', 'deporte', 'gastronomia', 'feria', 'religioso', 'institucional', 'otro']
        && d.fecha_inicio is timestamp && d.fecha_fin is timestamp && d.fecha_fin >= d.fecha_inicio
        && d.lugar_nombre is string && d.lugar_nombre.size() >= 2 && d.lugar_nombre.size() <= 80
        && d.get('municipio', 'Fusagasugá') in ['Fusagasugá', 'Pasca']
        && (d.get('lat', null) == null || d.lat is number) && (d.get('lng', null) == null || d.lng is number)
        && d.get('gratis', true) is bool
        && d.get('demo', false) is bool
        && d.get('fuente_oficial', false) is bool
        && (d.get('imagen', '') == '' || (d.imagen is string && d.imagen.matches('data:image/(webp|jpeg);base64,.*') && d.imagen.size() <= 360000))
        && (d.get('enlace_fuente', '') == '' || (d.enlace_fuente is string && d.enlace_fuente.matches('https://[^ ]+') && d.enlace_fuente.size() <= 500))
        && d.estado in ['pendiente', 'publicado', 'rechazado']
        && d.origen in ['admin', 'organizador', 'usuario', 'ia', 'automatico']
        && d.creado_por is string;
    }
    match /eventos/{id} {
      allow read: if resource.data.estado == 'publicado' || esAdmin()
        || (cuentaReal() && resource.data.creado_por == request.auth.uid);
      allow create: if eventoValido(request.resource.data)
        // Solo el admin crea eventos de ejemplo (demo)
        && (esAdmin()
          || (tienePerfil() && request.resource.data.estado == 'pendiente'
            && request.resource.data.origen in ['organizador', 'usuario', 'ia']
            && request.resource.data.creado_por == request.auth.uid
            && request.resource.data.get('demo', false) == false)
          // Organizador confiable: publica directo
          || (tienePerfil() && perfil().rol == 'organizador' && perfil().get('confiable', false) == true
            && request.resource.data.estado in ['publicado', 'pendiente']
            && request.resource.data.origen in ['organizador', 'ia']
            && request.resource.data.creado_por == request.auth.uid
            && request.resource.data.get('demo', false) == false));
      allow update: if esAdmin() && eventoValido(request.resource.data);
      allow delete: if esAdmin();
    }

    /* ---------- Invitaciones de organizadores (las crea el admin; cada quien lee solo la de su correo) ---------- */
    match /invitaciones/{correo} {
      allow read: if esAdmin() || (cuentaReal() && request.auth.token.email != null && request.auth.token.email.lower() == correo);
    }

    /* ---------- Límite de uso de la IA: 20 al día por persona (día UTC), solo sumando de a 1 ---------- */
    match /uso_ia/{uid} {
      allow read: if cuentaReal() && request.auth.uid == uid;
      allow create, update: if tienePerfil() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['dia', 'n', 'ultima'])
        && request.resource.data.dia == int(request.time.toMillis() / 86400000)
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 20
        && request.resource.data.ultima == request.time
        && (resource == null || resource.data.dia != request.resource.data.dia
          ? request.resource.data.n == 1
          : request.resource.data.n == resource.data.n + 1);
    }

    /* ---------- Moderación general (CU-18) ----------
       El admin puede todo, salvo en banners y eventos: ahí también debe cumplir la validación de su bloque. */
    match /{coleccion}/{documento=**} {
      allow read: if esAdmin();
      allow write: if esAdmin() && !(coleccion in ['banners', 'eventos']);
    }
  }
}
