{
  "ci": {
    "collect": {
      "startServerCommand": "python -u -m http.server 5511",
      "startServerReadyPattern": "Serving HTTP",
      "url": ["http://localhost:5511/"],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo", "pwa"],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:pwa": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:best-practices": ["warn", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:seo": ["warn", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:performance": ["warn", { "minScore": 0.6, "aggregationMethod": "median" }],
        "installable-manifest": ["error", { "minScore": 1 }],
        "service-worker": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "informe-pruebas/lighthouse",
      "reportFilenamePattern": "%%PATHNAME%%-%%DATETIME%%.%%EXTENSION%%"
    }
  }
}
