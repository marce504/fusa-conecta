{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "_redirects",
      "__/**",
      "**/.git/**",
      "**/.github/**",
      "**/.firebase/**",
      ".gitignore",
      "android/**",
      "api/**",
      "automatizacion/**",
      "render.yaml",
      "**/node_modules/**",
      "CLAUDE.md",
      "*.txt",
      "*.ai",
      "*.md",
      "logo whatsapp.jpg",
      "nuevo logo Fusa conecta.svg",
      "herramientas/**",
      "docs/**",
      "package.json",
      "package-lock.json",
      "eslint.config.js",
      "pyproject.toml",
      ".flake8",
      ".npmrc",
      ".prettierrc.json",
      ".prettierignore",
      "informe-pruebas/**",
      "pruebas/**",
      "playwright.config.js",
      "vitest.config.js",
      "lighthouserc.json",
      "test-results/**",
      ".lighthouseci/**"
    ],
    "headers": [
      {
        "source": "/@(sw.js|index.html|manifest.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8099
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
